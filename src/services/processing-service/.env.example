# =============================================================================
# Processing Service — environment configuration
# Copy this file to .env and edit as needed for local development.
# In Docker / production, inject variables directly as environment variables.
# All variables are optional unless marked REQUIRED.
# =============================================================================

# --- Service mode (REQUIRED) -------------------------------------------------
# EDGE   → ingest Extreme-Edge messages, persist locally, relay to cloud namespace
# CLOUD  → persist centrally, serve image retrieval API
SERVICE_MODE=EDGE

# --- MQTT Broker -------------------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
#MQTT_CLIENT_ID=processing-service   # must differ between edge and cloud instances

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://watchedge:watchedge@localhost:5432/watchedge-db

# --- Object Storage (S3-compatible) ------------------------------------------
OBJECT_STORAGE_URL=http://localhost:9000
S3_ACCESS_KEY=gBOAR
S3_SECRET_KEY=gBOARpass
S3_BUCKET=gboar-images
# S3_PUBLIC_URL=                      # public base URL for stored images;
#                                     # falls back to OBJECT_STORAGE_URL if unset

# --- HTTP Server -------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
