# =============================================================================
# Processing Service — environment configuration
# Copy this file to .env and edit as needed for local development.
# In Docker / production, inject variables directly as environment variables.
# All variables are optional unless marked REQUIRED.
# =============================================================================

# --- Service mode (REQUIRED) -------------------------------------------------
# [string] "EDGE"  → ingest Extreme-Edge messages, persist locally, relay to cloud namespace
#          "CLOUD" → persist centrally, serve image retrieval API
SERVICE_MODE=EDGE

# --- MQTT Broker -------------------------------------------------------------
# [string] Hostname or IP address of the MQTT broker
MQTT_HOST=localhost
# [int]    1–65535
MQTT_PORT=1883
# [string] Leave empty if the broker allows anonymous connections
#MQTT_USERNAME=
# [string] Leave empty if the broker allows anonymous connections
#MQTT_PASSWORD=
# [string] MQTT client identifier; auto-generated (UUID) if empty
#          Must differ between Edge and Cloud instances.
#MQTT_CLIENT_ID=

# --- Database ----------------------------------------------------------------
# [string] PostgreSQL connection string
DATABASE_URL=postgresql://watchedge:watchedge@localhost:5432/watchedge-db

# --- Object Storage (S3-compatible) ------------------------------------------
# [string] Internal S3-compatible endpoint URL (MUST be accessible by BOTH Camera and processing-service)
OBJECT_STORAGE_URL=http://localhost:9000
# [string] S3 access key
S3_ACCESS_KEY=watchedge
# [string] S3 secret key
S3_SECRET_KEY=watchedge
# [string] S3 bucket name
S3_BUCKET=watchedge-images
# [string] Public base URL for stored images; falls back to OBJECT_STORAGE_URL if empty
#S3_PUBLIC_URL=

# --- HTTP Server -------------------------------------------------------------
# [string] Bind address for the HTTP server; 0.0.0.0 listens on all interfaces
WEB_HOST=0.0.0.0
# [int]    1–65535
WEB_PORT=8000
# [string] External base URL for generating UI links (does not filter requests or validate host)
WEB_BASE_URL=http://localhost:8000
