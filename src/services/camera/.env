# =============================================================================
# Camera Service — environment configuration
# All variables are optional unless marked REQUIRED.
# Uncomment and edit any line to override the built-in default.
# =============================================================================

# --- Identity (REQUIRED) -----------------------------------------------------
EDGE_ID=a3f1b2c4-0000-0000-0000-000000000001
CAMERA_ID=7c8d9e0f-0000-0000-0000-000000000001

# --- MQTT Broker --------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_CLIENT_ID=          # auto-generated if empty

# --- WebUI --------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Inference ----------------------------------------------------------------
MODEL_PATH=model/best_yolov9t_aug.onnx
CONFIDENCE_THRESHOLD=0.6
IOU_THRESHOLD=0.5
# Maximum frames per second the inference loop will process.
# For a video source the effective rate is min(INFERENCE_FPS, video_native_fps).
INFERENCE_FPS=15

# --- Video Source -------------------------------------------------------------
# "usb"   → USB / V4L2 camera (USB_CAMERA_INDEX)
# "video" → first .mp4 / .avi found in SAMPLES_DIR/videos/
DEFAULT_SOURCE=video
USB_CAMERA_INDEX=0
SAMPLES_DIR=samples/
SCENES_FILE=samples/scenes.json

# --- Events -------------------------------------------------------------------
# Minimum seconds between two consecutive MQTT event publishes.
EVENT_THROTTLE_S=1.0
# Directory where annotated JPEG frames are saved for each published event.
IMAGE_DIR=data/images/
# How often (seconds) the telemetry/status heartbeat is published.
TELEMETRY_INTERVAL_S=30.0

# --- Birth / Registration payload --------------------------------------------
BIRTH_EDGE_NAME=MY_EDGE
BIRTH_EDGE_LOCATION=Unknown Location
BIRTH_CAMERA_TYPE=BOAR_CAMERA_V3
BIRTH_CAMERA_COORDS=POINT(0.0, 0.0)
BIRTH_ELEVATION=0
BIRTH_TECHNICAL_PARAMS_JSON={"iso": 800, "res": "2160x3840"}
