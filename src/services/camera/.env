# =============================================================================
# Camera Service — environment configuration
# All variables are optional unless marked REQUIRED.
# Uncomment and edit any line to override the built-in default.
# =============================================================================

# --- Identity (REQUIRED) -----------------------------------------------------
# [string] Valid RFC-4122 UUID — generate with: uuidgen
EDGE_ID=a3f1b2c4-0000-0000-0000-000000000001
# [string] Valid RFC-4122 UUID — generate with: uuidgen
CAMERA_ID=7c8d9e0f-0000-0000-0000-000000000001

# --- MQTT Broker --------------------------------------------------------------
# [string] Hostname or IP address of the MQTT broker
MQTT_HOST=localhost
# [int]    1–65535
MQTT_PORT=1883
# [string] Leave empty if the broker allows anonymous connections
#MQTT_USERNAME=
# [string] Leave empty if the broker allows anonymous connections
#MQTT_PASSWORD=
# [string] MQTT client identifier; auto-generated (UUID) if empty
#MQTT_CLIENT_ID=

# --- WebUI --------------------------------------------------------------------
# [string] Bind address for the HTTP management UI; 0.0.0.0 listens on all interfaces
WEB_HOST=0.0.0.0
# [int]    1–65535
WEB_PORT=8080

# --- Inference ----------------------------------------------------------------
# [string] Path to the ONNX model file (relative to the working directory or absolute)
MODEL_PATH=model/best_yolov9t_aug.onnx
# [float]  Detection confidence threshold — range 0.0–1.0
CONFIDENCE_THRESHOLD=0.6
# [float]  Non-maximum suppression IoU threshold — range 0.0–1.0
IOU_THRESHOLD=0.5
# [int]    1–120 — maximum frames per second processed by the inference loop.
#          For a video source the effective rate is min(INFERENCE_FPS, video_native_fps).
INFERENCE_FPS=5

# --- Video Source -------------------------------------------------------------
# [string] "usb"   → USB / V4L2 camera identified by USB_CAMERA_INDEX
#          "video" → first .mp4 / .avi found under SAMPLES_DIR/videos/
DEFAULT_SOURCE=video
# [int]    ≥0 — V4L2 device index (e.g. 0 → /dev/video0)
USB_CAMERA_INDEX=0
# [string] Directory that contains the videos/ subfolder with sample clips
SAMPLES_DIR=samples/
# [string] Path to the JSON file listing scene metadata for the sample videos
SCENES_FILE=samples/scenes.json

# --- Events -------------------------------------------------------------------
# [float]  >0 — minimum seconds between two consecutive MQTT event publishes
EVENT_THROTTLE_S=1.0
# [string] Directory where annotated JPEG frames are saved for each published event
IMAGE_DIR=data/images/
# [float]  >0 — interval in seconds between telemetry/status heartbeat publishes
TELEMETRY_INTERVAL_S=30.0

# --- Birth / Registration payload --------------------------------------------
# [string] Human-readable name for this edge node
BIRTH_EDGE_NAME=SAN_ROSSORE_PARK
# [string] Human-readable physical location description
BIRTH_EDGE_LOCATION=San Rossore Park (PI, Italy)
# [string] Camera hardware model identifier
BIRTH_CAMERA_TYPE=EXTREME_EDGE_CAMERA_V8
# [string] WKT POINT geometry: POINT(<longitude>, <latitude>)
BIRTH_CAMERA_COORDS=POINT(43.7233401, 10.3365951)
# [int]    Camera elevation above sea level in metres
BIRTH_ELEVATION=20
# [json]   Arbitrary key/value technical parameters (must be valid JSON object)
BIRTH_TECHNICAL_PARAMS_JSON={"res": "2568x1724"}
